<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.llm-security-digest.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ez/llm-security-digest/.venv/bin/python</string>
    <string>-m</string>
    <string>llm_security_digest.runner</string>
  </array>
  <key>WorkingDirectory</key>
