<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.llm-security-digest.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/hengzhao/LLMSecurityDigest/.venv/bin/python</string>
    <string>-m</string>
    <string>llm_security_digest.runner</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/hengzhao/LLMSecurityDigest</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
    <key>PATH</key>
    <string>/Users/hengzhao/LLMSecurityDigest/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!--
      SERPAPI_API_KEY and LLMSD_CONTACT_EMAIL must be set in the user's shell
      environment via ~/.hermes/.env or launchd's EnvironmentVariables below.
      They MUST NOT be hard-coded here because this file is tracked in git.
    -->
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/hengzhao/LLMSecurityDigest/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hengzhao/LLMSecurityDigest/logs/launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>