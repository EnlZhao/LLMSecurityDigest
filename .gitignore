# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Local virtualenv ---
.venv/
venv/

# --- Hermes (this assistant) state, rules, memories, cache ---
.hermes/

# --- Project-local generated state & downloads ---
.data/
cache/
logs/
RUN/
downloads/
run.lock
cron_prompt.md
# A custom LLMSD_DATA_DIR may live inside a checkout; keep SQLite route
# metadata and its WAL sidecars out of Git in that case as well.
route_catalog.sqlite3
route_catalog.sqlite3-shm
route_catalog.sqlite3-wal

# --- Secrets / env ---
.env
.env.*

# --- OS junk ---
.DS_Store
*.swp
*.tmp
*.log

# --- Repo metadata that should not be tracked as content ---
# AGENTS.md is intentionally not committed; the file on disk is still authoritative
# for this checkout, but it must not leak into other clones or pull requests.
AGENTS.md

# --- Misc generated docs that were already excluded ---
docs/superpowers/


# --- Launchd artifacts ---
# launchd/install.sh renders the .plist.template into a concrete .plist
# at install time. The concrete plist contains absolute paths to the
# current machine and must never be committed. The template and the
# install script are committed.
launchd/com.paperdaily.daily.plist
launchd/install.lock

# --- Tests ---
# Keep source regression tests under version control. Their caches remain
# ignored above.
